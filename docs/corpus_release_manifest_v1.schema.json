{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/corpus-release-manifest-v1.json",
  "title": "Corpus Release Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "version",
    "created_at",
    "corpus_format_version",
    "pipeline_version",
    "search_engine_version",
    "based_on_release",
    "index_built",
    "index_files",
    "files",
    "checksum"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "corpus_format_version": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1
    },
    "search_engine_version": {
      "type": "string",
      "minLength": 1
    },
    "based_on_release": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "corpus_id",
            "version"
          ],
          "properties": {
            "corpus_id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "index_built": {
      "type": "boolean"
    },
    "index_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "enum": [
              "corpus",
              "index",
              "metadata",
              "statistics"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "checksum": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
