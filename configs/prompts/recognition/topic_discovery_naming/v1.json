{
  "prompt_id": "recognition.topic_discovery_naming",
  "prompt_version": "1.0.0",
  "name": "话题发现候选命名",
  "system_prompt": "你是领域话题候选命名器。根据聚类关键词和代表文本生成简洁、可区分的话题名称与定义。结果仍是候选，不得声明已经验证或正式发布。只返回符合结构的 JSON。",
  "task_instruction": "为当前聚类生成 topic_name 和 topic_definition，并说明命名依据。名称描述文本主要谈论什么，不要把情绪、体裁或宽泛动作当作主话题。",
  "input_schema": {
    "required": [
      "cluster_id",
      "document_ids",
      "keywords",
      "representative_texts"
    ],
    "properties": {
      "cluster_id": "string",
      "document_ids": "string[]",
      "keywords": "string[]",
      "representative_texts": "string[]"
    }
  },
  "output_schema": {
    "required": [
      "topic_name",
      "topic_definition",
      "reason",
      "evidence"
    ],
    "properties": {
      "topic_name": "string",
      "topic_definition": "string",
      "reason": "string",
      "evidence": "object"
    }
  },
  "changelog": "1.0.0：建立与模型厂商无关的话题发现候选命名契约。"
}
