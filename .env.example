# Copy this file to .env locally. Never commit the real .env file.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=corpus_platform
DB_USER=corpus_user
DB_PASSWORD=
# Relative paths are resolved from the repository root, so this value is portable.
CORPUS_DATA_ROOT=data

# Optional: Python executable that contains BERTopic, sentence-transformers and HDBSCAN.
# If omitted, the platform discovers a sibling Conda environment named bertopic_env when available.
TOPIC_WORKFLOW_PYTHON=
API_HOST=127.0.0.1
API_PORT=8000
# Optional: set to 1 to forbid new BCC frequency requests and use cache only.
TERM_RECOGNITION_BCC_OFFLINE=0

# Multi-user portal; create accounts via python -m corpus_platform portal add-user.
PORTAL_PUBLIC_URL=http://127.0.0.1:8000
PORTAL_STORAGE=data/portal
PORTAL_TEMPLATE=portal_template
PORTAL_MAX_WORKERS=4
# Comma-separated administrator-approved HTTPS model API hostnames (port 443).
PORTAL_LLM_ALLOWED_HOSTS=api.openai.com

# Per-project total storage limit in GiB, including raw corpus, indexes and history.
PORTAL_PROJECT_QUOTA_GB=100
